# CAMPUS EVENT MANAGEMENT SYSTEM (CEMS)
# Copy this file to .env and fill in the values before running.

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/cems"
# For production use a secure connection string.

# JWT Authentication
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Application
NODE_ENV="development"
PORT="3000"
API_BASE_URL="http://localhost:3000/api/v1"
FRONTEND_URL="http://localhost:5173"
TZ="Asia/Kolkata"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Email (optional - required only for email verification/password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@campus.edu"

# File Storage (optional)
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"